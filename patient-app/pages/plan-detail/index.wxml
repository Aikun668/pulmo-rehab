<navigation-bar title="训练方案" back="{{true}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <view class="state-card" wx:if="{{isLoading}}">正在同步训练方案，请稍候...</view>
  <view class="state-card state-card--error" wx:elif="{{errorMessage}}">{{errorMessage}}</view>
  <block wx:elif="{{latestPlan}}">
    <view class="section-title">最新方案</view>
    <view class="card card--latest">
      <view class="card__title">{{latestPlan.title}}</view>
      <view class="card__desc">{{latestPlan.content}}</view>
      <view class="card__meta">最近更新：{{latestPlan.createdAt}}</view>
    </view>

    <view class="section-title section-title--history" wx:if="{{historyPlans.length}}">历史方案</view>
    <block wx:for="{{historyPlans}}" wx:key="id">
      <view class="card">
        <view class="card__title">{{item.title}}</view>
        <view class="card__desc">{{item.content}}</view>
        <view class="card__meta">{{item.createdAt}}</view>
      </view>
    </block>
  </block>
  <view class="state-card" wx:else>当前暂无训练方案，请等待医生下发。</view>
</view>
