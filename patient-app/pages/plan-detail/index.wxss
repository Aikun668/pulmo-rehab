.page {
  padding: 24rpx;
}

.section-title {
  margin: 0 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5b6b7a;
}

.section-title--history {
  margin-top: 28rpx;
}

.state-card,
.card {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
}

.card + .card {
  margin-top: 20rpx;
}

.card--latest {
  border-color: #bfdbfe;
  background: #f8fbff;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
}

.card__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.card__meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.state-card {
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.state-card--error {
  color: #c65b5b;
}
