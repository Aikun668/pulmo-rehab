<navigation-bar title="康复知识" back="{{true}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <!-- 等级标签 -->
  <view class="level-header" wx:if="{{rehabLevel > 0}}">
    <view class="level-header__tag" style="background: {{levelTagColor}}15; border-color: {{levelTagColor}};">
      <text style="color: {{levelTagColor}};">Level {{rehabLevel}} · {{levelTag}}</text>
    </view>
    <view class="level-header__hint">以下内容按您的康复等级推荐</view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list">
    <view class="article-item {{item.expanded ? 'article-item--expanded' : ''}}" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="handleToggleArticle">
      <view class="article-item__header">
        <view class="article-item__left">
          <view class="article-item__category" style="{{item.isLevelSpecific ? 'background: ' + levelTagColor + '15; color: ' + levelTagColor + ';' : 'background: #f1f5f9; color: #64748b;'}}">{{item.category}}</view>
          <view class="article-item__title">{{item.title}}</view>
          <view class="article-item__summary">{{item.summary}}</view>
        </view>
        <view class="article-item__arrow">{{item.expanded ? '▲' : '▼'}}</view>
      </view>

      <!-- 展开内容 -->
      <view class="article-item__content" wx:if="{{item.expanded}}">
        <view class="article-item__paragraph" wx:for="{{item.parsedContent}}" wx:for-item="line" wx:for-index="li" wx:key="li">
          <text wx:if="{{line.type === 'subtitle'}}" class="content-subtitle">{{line.text}}</text>
          <text wx:elif="{{line.type === 'list'}}" class="content-list-item">{{line.text}}</text>
          <text wx:else class="content-paragraph">{{line.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部免责 -->
  <view class="disclaimer">
    <text class="disclaimer__icon">ℹ</text>
    <text class="disclaimer__text">以上内容仅供参考，不构成医疗建议。具体治疗方案请遵医嘱。</text>
  </view>
</view>
