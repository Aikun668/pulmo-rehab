<view class="page" style="padding-top: {{contentTopPadding}}px;">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-bar__back" bindtap="handleBack">
      <text class="nav-bar__back-icon">‹</text>
    </view>
    <text class="nav-bar__title">训练方案分析</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载方案数据…</text>
  </view>

  <!-- 主内容 -->
  <view class="content" wx:if="{{!isLoading}}">

    <!-- ===== 方案总览卡 ===== -->
    <view class="overview-card">
      <view class="overview-card__accent" style="background: {{rehabLevelColor}};"></view>
      <view class="overview-card__header">
        <view class="overview-card__level-badge" style="background: {{rehabLevelColor}};">
          <text class="overview-card__level-text">Level {{rehabLevel}}</text>
        </view>
        <view class="overview-card__source-tag">
          <text class="overview-card__source-text">{{planSourceLabel}}</text>
        </view>
      </view>
      <text class="overview-card__title">{{planTitle}}</text>
      <text class="overview-card__advice">{{rehabLevelName}}阶段 · {{planSource === 'default' ? '等级标准方案' : '个性化定制方案'}}</text>

      <!-- 三格指标 -->
      <view class="overview-card__metrics">
        <view class="overview-card__metric">
          <view class="overview-card__metric-bar">
            <view class="overview-card__metric-bar-fill" style="width:{{todayProgressPercent}}%;background:{{rehabLevelColor}};"></view>
          </view>
          <text class="overview-card__metric-value">{{todayProgressMinutes}}<text class="overview-card__metric-unit">/{{totalTargetMinutes}}min</text></text>
          <text class="overview-card__metric-label">今日进度</text>
        </view>
        <view class="overview-card__metric-sep"></view>
        <view class="overview-card__metric">
          <text class="overview-card__metric-value">{{totalTargetMinutes}}<text class="overview-card__metric-unit">min</text></text>
          <text class="overview-card__metric-label">每日目标</text>
        </view>
        <view class="overview-card__metric-sep"></view>
        <view class="overview-card__metric">
          <text class="overview-card__metric-value">{{exerciseAnalysis.length}}<text class="overview-card__metric-unit">项</text></text>
          <text class="overview-card__metric-label">训练动作</text>
        </view>
      </view>
    </view>

    <!-- ===== 方案解读 ===== -->
    <view class="section-title">
      <view class="section-title__bar" style="background: {{rehabLevelColor}};"></view>
      <text class="section-title__text">方案解读</text>
      <text class="section-title__hint">点击展开详情</text>
    </view>

    <view class="analysis-list">
      <view class="analysis-card" wx:for="{{exerciseAnalysis}}" wx:key="name">
        <!-- 紧凑一行：编号 + 名称 + 摘要 + 箭头 -->
        <view class="analysis-card__row" bindtap="handleToggleExercise" data-idx="{{item.index}}">
          <view class="analysis-card__index" style="background: {{rehabLevelColor}}1A; color: {{rehabLevelColor}};">{{item.index + 1}}</view>
          <view class="analysis-card__info">
            <text class="analysis-card__name">{{item.name}}</text>
            <text class="analysis-card__summary">{{item.targetMinutes}}min · {{item.purpose}}</text>
          </view>
          <view class="analysis-card__toggle {{expandedMap[item.index] ? 'analysis-card__toggle--expanded' : ''}}">
            <text class="analysis-card__toggle-icon">{{expandedMap[item.index] ? '▾' : '▸'}}</text>
          </view>
        </view>
        <!-- 折叠详情 -->
        <view class="analysis-card__collapsed {{expandedMap[item.index] ? 'analysis-card__collapsed--show' : ''}}">
          <view class="analysis-card__section">
            <text class="analysis-card__section-title">为什么选择</text>
            <text class="analysis-card__section-content">{{item.reason}}</text>
          </view>
          <view class="analysis-card__section">
            <text class="analysis-card__section-title">循序渐进</text>
            <text class="analysis-card__section-content analysis-card__section-content--progression">{{item.progression}}</text>
          </view>
          <view class="analysis-card__section">
            <text class="analysis-card__section-title">与其他动作的关系</text>
            <text class="analysis-card__section-content">{{item.relation}}</text>
          </view>
          <view class="analysis-card__precautions" wx:if="{{item.precautions.length > 0}}">
            <text class="analysis-card__precautions-title">注意事项</text>
            <view class="analysis-card__precautions-list">
              <text class="analysis-card__precautions-item" wx:for="{{item.precautions}}" wx:for-item="p" wx:key="*this">· {{p}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 达成目标 ===== -->
    <view class="section-title">
      <view class="section-title__bar" style="background: #10B981;"></view>
      <text class="section-title__text">达成目标</text>
    </view>

    <view class="goal-card" wx:if="{{goalData.currentLevelTitle}}">
      <!-- 里程碑路线图 L1→L5 -->
      <view class="goal-card__timeline">
        <view class="goal-card__timeline-track"></view>
        <view class="goal-card__timeline-fill" style="width: {{goalData.progressPercent}}%; background: #10B981;"></view>
        <view class="goal-card__node" wx:for="{{milestoneNodes}}" wx:key="num" style="left:{{(item.num - 1) * 20}}%;">
          <view class="goal-card__node-dot" style="{{item.dotStyle}}"></view>
          <text class="goal-card__node-num {{item.isCurrent ? 'goal-card__node-num--current' : ''}}">{{item.num}}</text>
        </view>
      </view>

      <!-- 当前等级 -->
      <view class="goal-card__current">
        <view class="goal-card__current-header">
          <text class="goal-card__current-badge" style="background: {{rehabLevelColor}};">L{{rehabLevel}}</text>
          <text class="goal-card__current-title">{{goalData.currentLevelTitle}}</text>
        </view>
        <view class="goal-card__body-changes">
          <text class="goal-card__body-changes-title">身体变化</text>
          <view class="goal-card__body-changes-item" wx:for="{{goalData.currentBodyChanges}}" wx:key="*this">
            <text class="goal-card__body-changes-dot" style="background: {{rehabLevelColor}};"></text>
            <text class="goal-card__body-changes-text">{{item}}</text>
          </view>
        </view>
        <view class="goal-card__daily-life">
          <text class="goal-card__daily-life-label">日常生活</text>
          <text class="goal-card__daily-life-text">{{goalData.currentDailyLife}}</text>
        </view>
      </view>

      <!-- 下一步目标 -->
      <view class="goal-card__next" wx:if="{{goalData.nextLevelNum <= 5}}">
        <view class="goal-card__next-header">
          <text class="goal-card__next-arrow">→</text>
          <text class="goal-card__next-badge">L{{goalData.nextLevelNum}}</text>
          <text class="goal-card__next-title">{{goalData.nextLevelTitle}}</text>
        </view>
        <text class="goal-card__next-desc">{{goalData.nextGoalText}}</text>
      </view>

      <!-- 终极目标 -->
      <view class="goal-card__ultimate">
        <view class="goal-card__ultimate-header">
          <text class="goal-card__ultimate-star">★</text>
          <text class="goal-card__ultimate-title">最终目标</text>
        </view>
        <text class="goal-card__ultimate-desc">{{goalData.ultimateTitle}}：{{goalData.ultimateDailyLife}}</text>
      </view>
    </view>

    <!-- ===== 近7天训练回顾 ===== -->
    <view class="section-title">
      <view class="section-title__bar" style="background: {{rehabLevelColor}};"></view>
      <text class="section-title__text">近7天训练回顾</text>
    </view>

    <view class="history-card">
      <view class="history-card__stats-row">
        <view class="history-card__stat-item">
          <text class="history-card__stat-value">{{avgDuration}}</text>
          <text class="history-card__stat-label">日均时长(min)</text>
        </view>
        <view class="history-card__stat-divider"></view>
        <view class="history-card__stat-item">
          <text class="history-card__stat-value">{{completionRate7d}}%</text>
          <text class="history-card__stat-label">7天完成率</text>
        </view>
        <view class="history-card__stat-divider"></view>
        <view class="history-card__stat-item">
          <text class="history-card__stat-value">{{totalTargetMinutes}}</text>
          <text class="history-card__stat-label">每日目标(min)</text>
        </view>
      </view>

      <view class="history-card__chart" wx:if="{{recent7Days.length > 0}}">
        <!-- 目标虚线 -->
        <view class="history-card__target-line" wx:if="{{targetLineBottom > 0}}" style="bottom: {{targetLineBottom}}rpx;"></view>
        <view class="history-card__bar-item" wx:for="{{recent7Days}}" wx:key="dateLabel">
          <view class="history-card__bar-col" style="height: {{item.heightPercent}}%; background: {{item.isToday ? rehabLevelColor : '#93C5FD'}};"></view>
          <text class="history-card__bar-label">{{item.dateLabel}}</text>
          <text class="history-card__bar-value" wx:if="{{item.minutes > 0}}">{{item.minutes}}</text>
        </view>
      </view>
      <view class="history-card__empty" wx:if="{{recent7Days.length === 0}}">
        <text class="history-card__empty-text">暂无近7天训练数据</text>
      </view>
    </view>

    <!-- ===== 最近训练结果 ===== -->
    <view class="section-title" wx:if="{{lastDuration > 0}}">
      <view class="section-title__bar" style="background: {{rehabLevelColor}};"></view>
      <text class="section-title__text">最近训练结果</text>
    </view>

    <view class="result-card" wx:if="{{lastDuration > 0}}">
      <text class="result-card__date">{{lastTrainingDate}}</text>
      <view class="result-card__grid">
        <view class="result-card__cell">
          <view class="result-card__cell-dot" style="background: {{rehabLevelColor}};"></view>
          <text class="result-card__cell-value">{{lastDuration}}</text>
          <text class="result-card__cell-unit">min</text>
          <text class="result-card__cell-label">实际时长</text>
        </view>
        <view class="result-card__cell-sep"></view>
        <view class="result-card__cell">
          <view class="result-card__cell-dot" style="background: #F59E0B;"></view>
          <text class="result-card__cell-value">{{lastSets}}</text>
          <text class="result-card__cell-unit">组</text>
          <text class="result-card__cell-label">完成组数</text>
        </view>
        <view class="result-card__cell-sep"></view>
        <view class="result-card__cell">
          <view class="result-card__cell-dot" style="background: {{lastVsTargetPercent >= 80 ? '#10B981' : '#F59E0B'}};"></view>
          <text class="result-card__cell-value">{{lastVsTargetPercent}}%</text>
          <text class="result-card__cell-label">达标率</text>
        </view>
      </view>
      <view class="result-card__progress-track">
        <view class="result-card__progress-fill" style="width: {{lastVsTargetPercent}}%; background: {{lastVsTargetPercent >= 80 ? '#10B981' : '#F59E0B'}};"></view>
      </view>
    </view>

    <!-- 底部留白给吸底按钮 -->
    <view class="content-bottom-spacer"></view>
  </view>

  <!-- 吸底 CTA -->
  <view class="cta-sticky" wx:if="{{!isLoading}}">
    <view class="cta-btn" bindtap="handleGoPlanDetail">
      <text class="cta-btn__text">开始执行训练 ›</text>
    </view>
    <text class="cta-btn__hint">将进入训练执行页面，逐项计时完成动作</text>
  </view>
</view>
