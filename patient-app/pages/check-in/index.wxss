/* ===== 页面基础 ===== */
.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f9fafb;
  padding-top: 200rpx;
}

/* ===== 淡绿渐变装饰区（满屏宽，覆盖日期栏以上） ===== */
.gradient-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 460rpx;
  background: linear-gradient(180deg, #a7f3d0 0%, #d1fae5 30%, #ecfdf5 60%, #f9fafb 100%);
}

/* 渐变区内标题行+头像（叠加在背景之上，不影响渐变定位） */
.gradient-header__content {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 36rpx 24rpx 0;
  z-index: 3;
}

.gradient-header__left {
  display: flex;
  flex-direction: column;
}

.gradient-header__title {
  font-size: 56rpx;
  font-weight: 800;
  color: #243447;
  line-height: 1.2;
}

.gradient-header__sub {
  font-size: 32rpx;
  font-weight: 400;
  color: #5b6b7a;
  margin-top: 28rpx;
}

/* "今天" / "训练" 小标题样式 */
.page-subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #5b6b7a;
  margin: 0 24rpx;
  margin-bottom: 8rpx;
}

.page-subtitle--train {
  margin-top: 40rpx;
  margin-bottom: 24rpx;
}

.gradient-header__avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #e75480;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 24rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.10), 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  position: relative;
  z-index: 1;
}

/* ===== ① 日期+等级+今日时长+迷你统计 ===== */
.status-card {
  padding: 32rpx 28rpx 24rpx;
}

.status-card__row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-card__date {
  font-size: 26rpx;
  font-weight: 700;
  color: #243447;
}

.status-card__week-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.status-card__week-text {
  font-size: 22rpx;
  color: #8a9aad;
  font-weight: 400;
}

.status-card__week-arrow {
  font-size: 28rpx;
  color: #5b6b7a;
  font-weight: 600;
}

/* 等级徽章——紧凑行内标签 */
.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 0;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid;
  margin-top: 12rpx;
}

.level-badge__label {
  font-size: 20rpx;
  font-weight: 700;
}

.level-badge__sep {
  font-size: 26rpx;
  font-weight: 400;
}

.level-badge__name {
  font-size: 18rpx;
  font-weight: 500;
}

/* 主视觉区：大数字 + 迷你柱状图，底部对齐 */
.status-card__main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  min-height: 120rpx;
}

.status-card__value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.status-card__big-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #243447;
  line-height: 1;
}

.status-card__min-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #8a9aad;
  line-height: 1;
}

/* 迷你4天柱状图（右下角） */
.mini-chart {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  height: 100rpx;
  padding-bottom: 0;
}

.mini-chart__bar-wrap {
  display: flex;
  align-items: flex-end;
  width: 24rpx;
  height: 100rpx;
}

.mini-chart__bar {
  width: 100%;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 8rpx;
  transition: height 0.3s ease;
}

/* 内嵌安全警告 */
.status-card__warning {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fffbeb;
  border-radius: 12rpx;
  border: 1rpx solid #fde68a;
}

.status-card__warning-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.status-card__warning-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #92400e;
}

/* ===== 最近一周弹窗 ===== */
.modal-card--weekly {
  max-height: none;
}

.weekly-chart {
  margin-top: 16rpx;
}

.weekly-chart__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.weekly-chart__day-label {
  font-size: 22rpx;
  color: #5b6b7a;
  width: 60rpx;
  flex-shrink: 0;
  text-align: right;
}

.weekly-chart__bar-track {
  flex: 1;
  height: 28rpx;
  background: #f0fdf4;
  border-radius: 8rpx;
  overflow: hidden;
}

.weekly-chart__bar-fill {
  height: 100%;
  border-radius: 8rpx;
  min-width: 4rpx;
  transition: width 0.3s ease;
}

.weekly-chart__day-value {
  font-size: 22rpx;
  color: #243447;
  font-weight: 600;
  width: 64rpx;
  flex-shrink: 0;
  text-align: left;
}

/* ===== 通用操作卡片（②③④共享） ===== */
.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.action-card__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.action-card__icon-wrap--blue {
  background: #dbeafe;
}

.action-card__icon-wrap--green {
  background: #dcfce7;
}

.action-card__icon-wrap--orange {
  background: #fed7aa;
}

.action-card__emoji {
  font-size: 28rpx;
}

.action-card__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #16a34a;
}

.action-card__info {
  flex: 1;
}

.action-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #243447;
}

.action-card__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.action-card__arrow {
  font-size: 24rpx;
  font-weight: 600;
  min-width: 120rpx;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.action-card__arrow--blue {
  color: #ffffff;
  background: #86efac;
}

.action-card__arrow--green {
  color: #ffffff;
  background: #86efac;
}

.action-card__arrow--orange {
  color: #ffffff;
  background: #86efac;
}

/* 色系区分：自评蓝（灰调底） */
.action-card--blue {
  background: #f8f9fb;
  border: none;
}

.action-card--blue .action-card__title {
  color: #1e3a5f;
}

.action-card--blue .action-card__desc {
  color: #8a9aad;
}

/* 色系区分：呼吸绿（灰调底） */
.action-card--green {
  background: #f8f9fb;
  border: none;
}

.action-card--green .action-card__title {
  color: #1e3a5f;
}

.action-card--green .action-card__desc {
  color: #8a9aad;
}

/* 色系区分：任务橙（灰调底） */
.action-card--orange {
  background: #f8f9fb;
  border: none;
}

.action-card--orange .action-card__title {
  color: #1e3a5f;
}

.action-card--orange .action-card__desc {
  color: #8a9aad;
}

/* ===== 已完成小条 ===== */
.done-card {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f0fdf4;
  border-color: #bbf7d0;
  gap: 8rpx;
}

.done-card__icon {
  font-size: 24rpx;
  color: #16a34a;
  font-weight: 700;
}

.done-card__text {
  font-size: 26rpx;
  color: #16a34a;
  font-weight: 500;
}

/* ===== 呼吸计时器弹窗 ===== */
.modal-card--breath {
  max-height: none;
  padding: 32rpx 28rpx;
}

.breath-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.breath-panel__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #243447;
}

.breath-panel__close {
  font-size: 32rpx;
  color: #8a9aad;
  padding: 8rpx;
}

/* 圆圈 */
.breath-circle-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  position: relative;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
}

.breath-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 400rpx;
  height: 400rpx;
}

/* 轮次进度 */
.breath-progress {
  text-align: center;
  font-size: 24rpx;
  color: #5b6b7a;
  margin-top: 16rpx;
}

.breath-progress-bar {
  margin: 12rpx 40rpx 0;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e3ebf5;
  overflow: hidden;
}

.breath-progress-bar__fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #16a34a, #22c55e);
  transition: width 0.3s ease;
}

/* 控制按钮 */
.breath-controls {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.breath-controls__btn {
  min-width: 160rpx;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  padding: 0 32rpx;
}

.breath-controls__btn::after {
  border: none;
}

.breath-controls__btn--reset {
  background: #f1f5f9;
  color: #64748b;
}

.breath-controls__btn--start {
  background: linear-gradient(135deg, #16a34a, #22c55e);
  color: #ffffff;
}

.breath-controls__btn--pause {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #ffffff;
}

/* 完成状态 */
.breath-done {
  text-align: center;
  padding: 32rpx 0;
}

.breath-done__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-done__icon::after {
  content: "";
  display: block;
  width: 24rpx;
  height: 40rpx;
  border: solid #ffffff;
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.breath-done__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #16a34a;
}

.breath-done__time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5b6b7a;
}

.breath-done__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.breath-done__btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.breath-done__btn::after {
  border: none;
}

/* ===== 加载提示 ===== */
.loading-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #e3ebf5;
  border-top-color: #2a6bff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-hint__text {
  font-size: 24rpx;
  color: #8a9aad;
}

/* ===== 成功反馈浮层 ===== */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.success-card {
  margin: 0 64rpx;
  padding: 48rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.15);
}

.success-card__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-card__icon::after {
  content: "";
  display: block;
  width: 24rpx;
  height: 40rpx;
  border: solid #ffffff;
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.success-card__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1.6;
}

.success-card__tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6b7a;
}

/* ===== 模态框通用 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.modal-card {
  margin: 0 48rpx;
  width: calc(100vw - 96rpx);
  max-height: 85vh;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.2);
  overflow-y: auto;
}

.modal-card--warning {
  max-height: none;
  border: 2rpx solid #fca5a5;
}

.modal-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.modal-card__title--warning {
  color: #dc2626;
}

.modal-card__close {
  font-size: 32rpx;
  color: #8a9aad;
  padding: 8rpx;
}

/* ===== 评估表单 ===== */
.assess-field {
  margin-bottom: 28rpx;
}

.assess-field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #243447;
  margin-bottom: 8rpx;
}

.assess-field__optional {
  font-size: 22rpx;
  color: #8a9aad;
  font-weight: 400;
}

.assess-field__hint {
  font-size: 26rpx;
  color: #8a9aad;
  margin-bottom: 12rpx;
}

.assess-slider {
  width: 100%;
  margin: 0;
}

.assess-field__value {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #4CAF50;
  margin-top: 4rpx;
}

.assess-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.assess-input {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e2ec;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #243447;
}

.assess-input__unit {
  font-size: 24rpx;
  color: #8a9aad;
  flex-shrink: 0;
}

.assess-textarea {
  width: 100%;
  min-height: 80rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e2ec;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #243447;
  box-sizing: border-box;
}

.assess-submit-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: #4CAF50;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  padding: 0;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.25);
}

.assess-submit-btn::after {
  border: none;
}

/* ===== 安全预警弹窗 ===== */
.warning-content {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.warning-hint {
  font-size: 24rpx;
  color: #8a9aad;
  margin-bottom: 24rpx;
}

.warning-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: #dc2626;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.warning-btn::after {
  border: none;
}
