.page {
  padding: 24rpx;
  position: relative;
}

/* 成功反馈浮层 */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.success-card {
  margin: 0 64rpx;
  padding: 48rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.15);
}

.success-card__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 用伪元素画勾号 */
.success-card__icon::after {
  content: "";
  display: block;
  width: 24rpx;
  height: 40rpx;
  border: solid #ffffff;
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.success-card__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1.6;
}

/* 今日状态卡 */
.status-card {
  border-radius: 24rpx;
  background: #ffffff;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  border: 1rpx solid #e3ebf5;
}

.status-card__label {
  font-size: 22rpx;
  color: #8a9aad;
}

.status-card__date {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #243447;
}

.status-card__summary {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6b7a;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f4f8;
}

.status-card__summary--done {
  color: #16a34a;
  font-weight: 600;
}

/* 任务清单 */
.task-list {
  margin-top: 24rpx;
}

.task-list__header {
  font-size: 26rpx;
  font-weight: 600;
  color: #243447;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.04);
  transition: border-color 0.2s;
}

.task-item + .task-item {
  margin-top: 16rpx;
}

.task-item--checked {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.task-item__left {
  flex-shrink: 0;
  padding: 4rpx;
}

.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c4cdd5;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.task-checkbox--checked {
  border-color: #16a34a;
  background: #16a34a;
}

.task-checkbox__mark {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
}

.task-item__body {
  flex: 1;
  margin-left: 16rpx;
}

.task-item__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #243447;
  line-height: 1.4;
}

.task-item--checked .task-item__name {
  color: #15803d;
}

.task-item__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7a8a;
  line-height: 1.5;
}

.task-item__target {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
  font-weight: 500;
}

.task-item--checked .task-item__target {
  color: #4ade80;
}

.task-item__duration {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d4eadc;
}

.task-item__duration-label {
  font-size: 22rpx;
  color: #5b6b7a;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.task-item__duration-input {
  width: 120rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #d9e2ec;
  text-align: center;
  font-size: 26rpx;
  color: #243447;
}

.task-item__duration-unit {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
  flex-shrink: 0;
}

/* 提交按钮 */
.submit-button {
  margin-top: 32rpx;
  min-height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  letter-spacing: 2rpx;
}

.submit-button::after {
  border: none;
}

.submit-button--disabled {
  background: linear-gradient(135deg, #94a3b8 0%, #b0bec5 100%);
  color: rgba(255, 255, 255, 0.7);
}
