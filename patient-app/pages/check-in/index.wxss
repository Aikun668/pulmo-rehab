.page {
  padding: 24rpx;
  position: relative;
}

/* ===== 安全提示 ===== */
.safety-tip {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  margin-bottom: 20rpx;
}

.safety-tip__icon {
  font-size: 22rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.safety-tip__text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #92400e;
}

/* ===== 成功反馈浮层 ===== */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.success-card {
  margin: 0 64rpx;
  padding: 48rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.15);
}

.success-card__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-card__icon::after {
  content: "";
  display: block;
  width: 24rpx;
  height: 40rpx;
  border: solid #ffffff;
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.success-card__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1.6;
}

.success-card__tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6b7a;
}

/* ===== 今日状态卡 ===== */
.status-card {
  border-radius: 24rpx;
  background: #ffffff;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  border: 1rpx solid #e3ebf5;
  margin-bottom: 20rpx;
}

.status-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-card__label {
  font-size: 22rpx;
  color: #8a9aad;
}

.status-card__date {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #243447;
}

.status-card__summary {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6b7a;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f4f8;
}

.status-card__summary--done {
  color: #16a34a;
  font-weight: 600;
}

/* ===== 康复等级徽章 ===== */
.level-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid;
  flex-shrink: 0;
}

.level-badge__label {
  font-size: 22rpx;
  font-weight: 700;
}

.level-badge__name {
  font-size: 20rpx;
  font-weight: 500;
}

/* ===== 呼吸陪练入口 ===== */
.breath-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f0fdf4;
  border-radius: 20rpx;
  border: 1rpx solid #bbf7d0;
  margin-bottom: 20rpx;
}

.breath-entry__left {
  display: flex;
  align-items: center;
  flex: 1;
}

.breath-entry__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #dcfce7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.breath-entry__dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #16a34a;
}

.breath-entry__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #15803d;
}

.breath-entry__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #4ade80;
}

.breath-entry__action {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

/* ===== 呼吸计时器面板 ===== */
.breath-panel {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.breath-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.breath-panel__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #243447;
}

.breath-panel__close {
  font-size: 32rpx;
  color: #8a9aad;
  padding: 8rpx;
}

/* 圆圈 */
.breath-circle-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.breath-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.8s ease;
}

.breath-circle--inhale {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  border: 4rpx solid #4ade80;
}

.breath-circle--hold {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  border: 4rpx solid #60a5fa;
}

.breath-circle--exhale {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  border: 4rpx solid #4ade80;
}

.breath-circle__countdown {
  font-size: 64rpx;
  font-weight: 700;
  color: #243447;
  line-height: 1;
}

.breath-circle__label {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5b6b7a;
}

/* 轮次进度 */
.breath-progress {
  text-align: center;
  font-size: 24rpx;
  color: #5b6b7a;
  margin-top: 16rpx;
}

.breath-progress-bar {
  margin: 12rpx 40rpx 0;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e3ebf5;
  overflow: hidden;
}

.breath-progress-bar__fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #16a34a, #22c55e);
  transition: width 0.3s ease;
}

/* 控制按钮 */
.breath-controls {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.breath-controls__btn {
  min-width: 160rpx;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  padding: 0 32rpx;
}

.breath-controls__btn::after {
  border: none;
}

.breath-controls__btn--reset {
  background: #f1f5f9;
  color: #64748b;
}

.breath-controls__btn--start {
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
}

.breath-controls__btn--pause {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #ffffff;
}

/* 完成状态 */
.breath-done {
  text-align: center;
  padding: 32rpx 0;
}

.breath-done__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-done__icon::after {
  content: "";
  display: block;
  width: 24rpx;
  height: 40rpx;
  border: solid #ffffff;
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.breath-done__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #16a34a;
}

.breath-done__time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5b6b7a;
}

.breath-done__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.breath-done__btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.breath-done__btn::after {
  border: none;
}

/* ===== 处方标题 ===== */
.prescription-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e3ebf5;
  margin-bottom: 16rpx;
}

.prescription-header__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #243447;
  flex: 1;
}

.prescription-header__tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.prescription-header__tag--ai {
  background: #ede9fe;
  color: #7c3aed;
}

.prescription-header__tag--approved {
  background: #dcfce7;
  color: #16a34a;
}

.prescription-header__tag--default {
  background: #f0fdf4;
  color: #16a34a;
}

/* ===== 加载提示 ===== */
.loading-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #e3ebf5;
  border-top-color: #2a6bff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-hint__text {
  font-size: 24rpx;
  color: #8a9aad;
}

/* ===== 任务清单 ===== */
.task-list {
  margin-top: 4rpx;
}

.task-list__header {
  font-size: 26rpx;
  font-weight: 600;
  color: #243447;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.04);
  transition: border-color 0.2s;
}

.task-item + .task-item {
  margin-top: 16rpx;
}

.task-item--checked {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.task-item__left {
  flex-shrink: 0;
  padding: 4rpx;
}

.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c4cdd5;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.task-checkbox--checked {
  border-color: #16a34a;
  background: #16a34a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.task-item__body {
  flex: 1;
  margin-left: 16rpx;
}

.task-item__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #243447;
  line-height: 1.4;
}

.task-item--checked .task-item__name {
  color: #15803d;
}

.task-item__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7a8a;
  line-height: 1.5;
}

.task-item__target {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9aad;
  font-weight: 500;
}

.task-item--checked .task-item__target {
  color: #4ade80;
}

/* 展开/折叠按钮 */
.task-item__expand-btn {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #2a6bff;
  font-weight: 500;
}

/* 步骤详情 */
.task-item__detail {
  margin-top: 14rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e3ebf5;
}

.task-item__detail-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #5b6b7a;
  margin-bottom: 10rpx;
}

.task-item__step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.task-item__step-num {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #2a6bff;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
  line-height: 32rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.task-item__step-text {
  font-size: 22rpx;
  color: #4a5b6c;
  line-height: 1.6;
  flex: 1;
}

.task-item__precautions {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #d4eadc;
}

.task-item__precaution {
  display: flex;
  align-items: flex-start;
  margin-bottom: 6rpx;
}

.task-item__precaution-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.task-item__precaution-text {
  font-size: 20rpx;
  color: #d97706;
  line-height: 1.5;
}

.task-item__duration {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d4eadc;
}

.task-item__duration-label {
  font-size: 22rpx;
  color: #5b6b7a;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.task-item__duration-input {
  width: 120rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #d9e2ec;
  text-align: center;
  font-size: 26rpx;
  color: #243447;
}

.task-item__duration-unit {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
  flex-shrink: 0;
}

/* ===== 提交按钮 ===== */
.submit-button {
  margin-top: 32rpx;
  min-height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  letter-spacing: 2rpx;
}

.submit-button::after {
  border: none;
}

.submit-button--disabled {
  background: linear-gradient(135deg, #94a3b8 0%, #b0bec5 100%);
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 训练前自评入口 ===== */
.assessment-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #eff6ff;
  border-radius: 20rpx;
  border: 1rpx solid #bfdbfe;
  margin-bottom: 20rpx;
}

.assessment-entry__left {
  display: flex;
  align-items: center;
  flex: 1;
}

.assessment-entry__icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.assessment-entry__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.assessment-entry__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #60a5fa;
}

.assessment-entry__action {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.assessment-done {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f0fdf4;
  border-radius: 16rpx;
  border: 1rpx solid #bbf7d0;
  margin-bottom: 20rpx;
  gap: 8rpx;
}

.assessment-done__icon {
  font-size: 22rpx;
  color: #16a34a;
  font-weight: 700;
}

.assessment-done__text {
  font-size: 24rpx;
  color: #16a34a;
  font-weight: 500;
}

/* ===== 模态框通用 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.modal-card {
  margin: 0 48rpx;
  width: calc(100vw - 96rpx);
  max-height: 85vh;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.2);
  overflow-y: auto;
}

.modal-card--warning {
  max-height: none;
  border: 2rpx solid #fca5a5;
}

.modal-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.modal-card__title--warning {
  color: #dc2626;
}

.modal-card__close {
  font-size: 32rpx;
  color: #8a9aad;
  padding: 8rpx;
}

/* ===== 评估表单 ===== */
.assess-field {
  margin-bottom: 28rpx;
}

.assess-field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #243447;
  margin-bottom: 8rpx;
}

.assess-field__optional {
  font-size: 22rpx;
  color: #8a9aad;
  font-weight: 400;
}

.assess-field__hint {
  font-size: 20rpx;
  color: #8a9aad;
  margin-bottom: 12rpx;
}

.assess-slider {
  width: 100%;
  margin: 0;
}

.assess-field__value {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a6bff;
  margin-top: 4rpx;
}

.assess-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.assess-input {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e2ec;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #243447;
}

.assess-input__unit {
  font-size: 24rpx;
  color: #8a9aad;
  flex-shrink: 0;
}

.assess-textarea {
  width: 100%;
  min-height: 80rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e2ec;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #243447;
  box-sizing: border-box;
}

.assess-submit-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.assess-submit-btn::after {
  border: none;
}

/* ===== 安全预警弹窗 ===== */
.warning-content {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.warning-hint {
  font-size: 24rpx;
  color: #8a9aad;
  margin-bottom: 24rpx;
}

.warning-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: #dc2626;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.warning-btn::after {
  border: none;
}
