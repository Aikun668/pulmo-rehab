<navigation-bar title="个人中心" back="{{true}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-card__avatar">
      <text class="user-card__avatar-text">{{userName[0] || '?'}}</text>
    </view>
    <view class="user-card__info">
      <view class="user-card__name">{{userName}}</view>
      <view class="user-card__id">患者 ID：{{patientId}}</view>
      <view class="user-card__doctor" wx:if="{{doctorId}}">主治医生 ID：{{doctorId}}</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="handleLogout">
      <view class="menu-item__left">
        <text class="menu-item__icon">🚪</text>
        <text class="menu-item__label">退出登录</text>
      </view>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">肺康复助手 v1.0.0</view>
</view>
