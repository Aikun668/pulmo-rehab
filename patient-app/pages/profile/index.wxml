<navigation-bar title="" back="{{false}}" color="#1F2937" background="#F5F6F8">
</navigation-bar>

<view class="page">
  <!-- 上半区：用户信息 -->
  <view class="profile-hero">
    <view class="profile-hero__avatar">
      <text class="profile-hero__avatar-text">{{avatarSurname}}</text>
    </view>
    <view class="profile-hero__name">{{greetingText}}</view>
    <view class="profile-hero__role">患者用户 · {{userName}}</view>
  </view>

  <!-- 下半区：功能列表 -->
  <view class="menu-list">
    <view class="menu-item" data-key="info" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--blue">
        <text class="menu-item__icon">👤</text>
      </view>
      <text class="menu-item__label">个人信息</text>
      <text class="menu-item__arrow">›</text>
    </view>

    <view class="menu-item" data-key="plan" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--green">
        <text class="menu-item__icon">📋</text>
      </view>
      <text class="menu-item__label">我的方案</text>
      <text class="menu-item__arrow">›</text>
    </view>

    <view class="menu-item" data-key="progress" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--orange">
        <text class="menu-item__icon">📊</text>
      </view>
      <text class="menu-item__label">训练记录</text>
      <text class="menu-item__arrow">›</text>
    </view>

    <view class="menu-item" data-key="settings" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--purple">
        <text class="menu-item__icon">⚙</text>
      </view>
      <text class="menu-item__label">设置</text>
      <text class="menu-item__arrow">›</text>
    </view>

    <view class="menu-item" data-key="disclaimer" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--gray">
        <text class="menu-item__icon">⚠</text>
      </view>
      <text class="menu-item__label">免责声明</text>
      <text class="menu-item__arrow">›</text>
    </view>

    <view class="menu-item" data-key="logout" bindtap="handleMenuTap">
      <view class="menu-item__icon-wrap menu-item__icon-wrap--red">
        <text class="menu-item__icon">🚪</text>
      </view>
      <text class="menu-item__label">退出登录</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>

  <!-- 版本 -->
  <view class="version-info">肺康复助手 v1.0.0</view>
</view>
