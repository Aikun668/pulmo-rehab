<navigation-bar title="AI指导" back="{{true}}" color="#1F2937" background="#F5F7FA"></navigation-bar>

<view class="page">

  <!-- 康复状态摘要 -->
  <view class="status-card">
    <view class="status-card__row">
      <view class="status-card__item">
        <view class="status-card__icon status-card__icon--level">
          <view class="icon-level">
            <view class="icon-level__bar"></view>
            <view class="icon-level__bar icon-level__bar--mid"></view>
            <view class="icon-level__bar icon-level__bar--short"></view>
          </view>
        </view>
        <view class="status-card__value status-card__value--level">{{rehabLevel}}</view>
        <view class="status-card__label">康复等级</view>
      </view>
      <view class="status-card__divider"></view>
      <view class="status-card__item">
        <view class="status-card__icon">
          <view class="icon-calendar-sm">
            <view class="icon-calendar-sm__header"></view>
            <view class="icon-calendar-sm__body">{{recentTrainedDays}}</view>
          </view>
        </view>
        <view class="status-card__value status-card__value--dual">
          <text>{{recentTrainedDays}}天</text>
          <text>{{recentTotalMinutes}}分钟</text>
        </view>
        <view class="status-card__label">近7天训练</view>
      </view>
      <view class="status-card__divider"></view>
      <view class="status-card__item">
        <view class="status-card__icon">
          <view class="icon-rate-sm">
            <view class="icon-rate-sm__circle"></view>
            <view class="icon-rate-sm__fill"></view>
          </view>
        </view>
        <view class="status-card__value">{{completionRate}}</view>
        <view class="status-card__label">完成率</view>
      </view>
    </view>
  </view>

  <!-- 分组标题：AI综合指导 -->
  <view class="section-title">
    <view class="section-title__bar"></view>
    <text class="section-title__text">AI综合指导</text>
  </view>

  <!-- AI指导内容卡片 -->
  <view class="guidance-card">
    <view class="guidance-card__header">
      <view class="guidance-card__badge">AI生成</view>
      <view class="guidance-card__time">{{aiGuidance.updatedAt}}</view>
    </view>
    <!-- 总结语（始终展示） -->
    <view class="guidance-card__summary" wx:if="{{aiGuidance.summary}}">{{aiGuidance.summary}}</view>
    <!-- 可展开收起的详细指导 -->
    <view class="guidance-card__detail-toggle" bindtap="handleToggleGuidance">
      <text>{{guidanceExpanded ? '收起详细指导' : '查看详细指导'}}</text>
      <view class="guidance-card__detail-arrow {{guidanceExpanded ? 'guidance-card__detail-arrow--up' : ''}}"></view>
    </view>
    <view hidden="{{!guidanceExpanded}}" class="guidance-card__detail">
      <view class="guidance-card__intro">{{aiGuidance.intro}}</view>
      <view class="guidance-card__list">
        <view class="guidance-card__item" wx:for="{{aiGuidance.points}}" wx:key="index">
          <view class="guidance-card__num">{{index + 1}}</view>
          <view class="guidance-card__text">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分组标题：继续提问 -->
  <view class="section-title">
    <view class="section-title__bar"></view>
    <text class="section-title__text">继续向AI提问</text>
  </view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{!chatLoading}}">
    <view class="quick-question" wx:for="{{quickQuestions}}" wx:key="index" data-q="{{item}}" bindtap="handleQuickQuestion">
      {{item}}
    </view>
  </view>

  <!-- 对话区域 -->
  <view class="chat-area" wx:if="{{messages.length > 0}}">
    <view class="chat-msg" wx:for="{{messages}}" wx:key="id">
      <view class="chat-msg__row chat-msg__row--{{item.role}}">
        <view class="chat-msg__avatar chat-msg__avatar--{{item.role}}">
          <view wx:if="{{item.role === 'ai'}}" class="avatar-ai">AI</view>
          <view wx:if="{{item.role === 'user'}}" class="avatar-user">
            <view class="avatar-user__head"></view>
            <view class="avatar-user__body"></view>
          </view>
        </view>
        <view class="chat-msg__bubble chat-msg__bubble--{{item.role}}">
          <block wx:for="{{item.contentLines}}" wx:key="index" wx:for-item="line">
            <text>{{line}}</text>
            <view wx:if="{{index < item.contentLines.length - 1}}" class="chat-msg__newline"></view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input class="input-bar__field" placeholder="输入康复问题…" value="{{inputText}}" bindinput="handleInputChange" bindconfirm="handleSend" confirm-type="send" disabled="{{chatLoading}}" />
    <view class="input-bar__send {{inputText && !chatLoading ? 'input-bar__send--active' : ''}}" bindtap="handleSend">发送</view>
  </view>

</view>
