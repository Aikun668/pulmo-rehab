.page {
  padding: 24rpx;
}

.card {
  border-radius: 24rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
}

.card__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card__created-at {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card__status {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #5b6b7a;
}

.card__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.9;
  color: #5b6b7a;
}
