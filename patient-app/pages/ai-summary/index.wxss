.page {
  padding: 24rpx;
  background: #F4F7FB;
  min-height: 100vh;
}

.loading-hint {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #8a9aad;
}

/* ===== 最新卡片 ===== */
.card {
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  position: relative;
}

.card--latest {
  border-color: #d4eadc;
  background: #f0faf4;
}

.card__badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 0 0 10rpx 10rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
}

.card__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card__created-at {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.9;
  color: #5b6b7a;
}

/* ===== 历史列表 ===== */
.history-section {
  margin-top: 32rpx;
}

.history-section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a4a5c;
  margin-bottom: 16rpx;
}

.history-item {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.history-item__meta {
  font-size: 24rpx;
  font-weight: 600;
  color: #3a4a5c;
}

.history-item__time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.history-item__content {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}
