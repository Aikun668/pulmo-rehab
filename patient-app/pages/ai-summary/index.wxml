<navigation-bar title="AI 小结" back="{{true}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <!-- 加载态 -->
  <view class="loading-hint" wx:if="{{isLoading}}">正在同步最新 AI 康复小结...</view>

  <!-- 最新一期 -->
  <view class="card card--latest" wx:if="{{hasSummary}}">
    <view class="card__badge">最新</view>
    <view class="card__title">最新周期</view>
    <view class="card__meta">{{latestPeriod}}</view>
    <view class="card__created-at">{{latestCreatedAt}}</view>
    <view class="card__desc">{{latestContent}}</view>

    <!-- 数据趋势 -->
    <view class="trend-section">
      <view class="trend-section__title">数据趋势（本周 vs 上周）</view>
      <view class="trend-grid">
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.days.current}}</view>
          <view class="trend-cell__label">训练天数</view>
          <view class="trend-cell__change trend-cell__change--{{trend.days.trend}}">{{trend.days.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.days.previous}}</view>
        </view>
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.minutes.current}}</view>
          <view class="trend-cell__label">累计时长(分)</view>
          <view class="trend-cell__change trend-cell__change--{{trend.minutes.trend}}">{{trend.minutes.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.minutes.previous}}</view>
        </view>
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.avg.current}}</view>
          <view class="trend-cell__label">日均时长(分)</view>
          <view class="trend-cell__change trend-cell__change--{{trend.avg.trend}}">{{trend.avg.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.avg.previous}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="card" wx:if="{{!isLoading && !hasSummary}}">
    <view class="card__title">最新周期</view>
    <view class="card__meta">{{latestPeriod}}</view>
    <view class="card__created-at">{{latestCreatedAt}}</view>
    <view class="card__desc">{{latestContent}}</view>

    <!-- 数据趋势 -->
    <view class="trend-section">
      <view class="trend-section__title">数据趋势（本周 vs 上周）</view>
      <view class="trend-grid">
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.days.current}}</view>
          <view class="trend-cell__label">训练天数</view>
          <view class="trend-cell__change trend-cell__change--{{trend.days.trend}}">{{trend.days.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.days.previous}}</view>
        </view>
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.minutes.current}}</view>
          <view class="trend-cell__label">累计时长(分)</view>
          <view class="trend-cell__change trend-cell__change--{{trend.minutes.trend}}">{{trend.minutes.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.minutes.previous}}</view>
        </view>
        <view class="trend-cell">
          <view class="trend-cell__value">{{trend.avg.current}}</view>
          <view class="trend-cell__label">日均时长(分)</view>
          <view class="trend-cell__change trend-cell__change--{{trend.avg.trend}}">{{trend.avg.label}}</view>
          <view class="trend-cell__prev">上周 {{trend.avg.previous}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史列表 -->
  <view class="history-section" wx:if="{{summaries.length > 0}}">
    <view class="history-section__title">历史小结</view>
    <view class="history-item" wx:for="{{summaries}}" wx:key="id">
      <view class="history-item__meta">{{item.period}}</view>
      <view class="history-item__time">{{item.createdAt}}</view>
      <view class="history-item__content">{{item.content}}</view>
    </view>
  </view>
</view>
