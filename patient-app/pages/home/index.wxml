<navigation-bar title="肺康复训练" back="{{false}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <!-- 问候区 -->
  <view class="header-section">
    <view class="header-section__eyebrow">{{welcomeLabel}}</view>
    <view class="header-section__title">{{patientName}}</view>
    <view class="header-section__streak" wx:if="{{streakDays > 0}}">已连续打卡 {{streakDays}} 天</view>
  </view>

  <!-- 卡片1：今日进度 + 任务速览 -->
  <view class="card">
    <view class="card__top">
      <view class="card__progress-block">
        <view class="card__eyebrow">今日康复进度</view>
        <view class="card__progress-row">
          <text class="card__progress-number">{{progressPercent}}</text>
          <text class="card__progress-unit">%</text>
        </view>
        <view class="card__progress-label">{{todayStatusLabel}}</view>
      </view>
      <view class="progress-ring">
        <canvas class="progress-ring__canvas" type="2d" id="progressRing" style="width: 150rpx; height: 150rpx;"></canvas>
      </view>
    </view>

    <view class="card__divider"></view>

    <!-- 今日任务速览 -->
    <view class="card__section-title">今日训练任务</view>
    <view class="task-list">
      <view class="task-item" wx:for="{{todayTasks}}" wx:key="id">
        <view class="task-item__dot {{item.done ? 'task-item__dot--done' : ''}}"></view>
        <view class="task-item__info">
          <view class="task-item__name {{item.done ? 'task-item__name--done' : ''}}">{{item.name}}</view>
          <view class="task-item__target">{{item.target}}</view>
        </view>
      </view>
    </view>

    <view class="card__action-row">
      <view class="card__quick-links">
        <view class="card__quick-link" data-key="progress" bindtap="handleQuickActionTap">
          <image class="card__quick-link-icon" src="/images/home/trend.png" mode="aspectFit"></image>
          <text>30天进度</text>
        </view>
        <view class="card__quick-link" data-key="ai-summary" bindtap="handleQuickActionTap">
          <image class="card__quick-link-icon" src="/images/home/check.png" mode="aspectFit"></image>
          <text>AI小结</text>
        </view>
      </view>
      <view class="card__btn-primary" bindtap="handleGoCheckIn">
        <text class="card__btn-text">去打卡</text>
      </view>
    </view>
  </view>

  <!-- 卡片2：AI 康复小结 -->
  <view class="tips-card">
    <view class="tips-card__top">
      <view class="tips-card__title-group">
        <view class="tips-card__badge">
          <image class="tips-card__badge-image" src="/images/home/sparkle.png" mode="aspectFit"></image>
        </view>
        <view class="tips-card__tag">AI 康复小结</view>
      </view>
      <view class="tips-card__time">{{aiTipUpdatedAt}}</view>
    </view>
    <view class="tips-card__content">{{aiTip}}</view>
  </view>
</view>
