/* ===== 页面基础 ===== */
.page {
  padding: 48rpx 36rpx 80rpx;
  background: #F4F7FB;
  height: 100vh;
  overflow: hidden;
}

/* ===== 问候区 ===== */
.header-section {
  margin-bottom: 16rpx;
  padding: 12rpx 4rpx 0;
}

.header-section__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-section__text {
  flex: 1;
}

.header-section__eyebrow {
  font-size: 24rpx;
  font-weight: 600;
  color: #2563eb;
}

.header-section__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1f2937;
}

.header-section__streak {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #16a34a;
  line-height: 1.4;
}

/* ===== 首页等级徽章 ===== */
.level-badge-home {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid;
  flex-shrink: 0;
}

.level-badge-home__label {
  font-size: 24rpx;
  font-weight: 700;
}

.level-badge-home__name {
  font-size: 18rpx;
  font-weight: 500;
}

/* ===== 通用卡片 ===== */
.card {
  margin-top: 32rpx;
  padding: 32rpx 28rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ===== 卡片1：进度 + 任务速览 ===== */
.card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card__progress-block {
  flex: 1;
}

.card__eyebrow {
  font-size: 24rpx;
  color: #6b7a8a;
}

.card__progress-row {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
}

.card__progress-number {
  font-size: 64rpx;
  line-height: 1;
  font-weight: 700;
  color: #1f2937;
}

.card__progress-unit {
  margin-left: 4rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #6b7a8a;
}

.card__progress-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.progress-ring {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.progress-ring__canvas {
  width: 150rpx;
  height: 150rpx;
  display: block;
}

.card__divider {
  margin: 24rpx 0 20rpx;
  height: 1rpx;
  background: #eef1f6;
}

.card__section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #3a4a5c;
  margin-bottom: 16rpx;
}

/* ===== 任务速览列表 ===== */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.task-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d1d5db;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.task-item__dot--done {
  background: #16a34a;
}

.task-item__info {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.task-item__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.task-item__name--done {
  color: #9ca3af;
  text-decoration: line-through;
}

.task-item__target {
  font-size: 22rpx;
  color: #6b7a8a;
}

/* ===== 底部操作行：快捷入口 + 打卡按钮 ===== */
.card__action-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card__quick-links {
  display: flex;
  gap: 28rpx;
}

.card__quick-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 500;
}

.card__quick-link-icon {
  width: 28rpx;
  height: 28rpx;
}

.card__btn-primary {
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  background: #2a6bff;
}

.card__btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

/* ===== 今日训练建议卡片 ===== */
.advice-card {
  margin-top: 32rpx;
  padding: 24rpx 28rpx 26rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
  border-radius: 24rpx;
  border: 1rpx solid #bfdbfe;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.advice-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.advice-card__title-group {
  display: flex;
  align-items: center;
}

.advice-card__icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.advice-card__tag {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.advice-card__level {
  font-size: 22rpx;
  font-weight: 700;
}

.advice-card__content {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.82;
  color: #1e40af;
}

/* ===== AI 小结卡片 ===== */
.tips-card {
  margin-top: 32rpx;
  padding: 24rpx 28rpx 26rpx;
  background: #d8f4e7;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tips-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tips-card__title-group {
  display: flex;
  align-items: center;
}

.tips-card__badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tips-card__badge-image {
  width: 24rpx;
  height: 24rpx;
}

.tips-card__tag {
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d7f53;
}

.tips-card__time {
  font-size: 22rpx;
  color: #4f8a6b;
  margin-left: 20rpx;
  white-space: nowrap;
}

.tips-card__content {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.82;
  letter-spacing: -0.2rpx;
  color: #356a4f;
}
