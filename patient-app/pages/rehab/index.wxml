<navigation-bar title="我的康复" back="{{false}}" color="#1F2937" background="#F4F7FB"></navigation-bar>

<view class="page">
  <view class="card" bindtap="handleOpenPlanDetail">
    <view class="card__title">我的训练方案</view>
    <view class="card__desc">{{latestPlanTitle}}</view>
    <view class="card__meta">{{latestPlanDescription}}</view>
    <view class="card__status" wx:if="{{isLoadingPlan}}">正在同步最新方案...</view>
    <view class="card__status card__status--error" wx:elif="{{planErrorMessage}}">
      {{planErrorMessage}}
    </view>
    <view class="card__status" wx:elif="{{hasPlan}}">{{latestPlanUpdatedAt}}</view>
    <view class="card__status" wx:else>当前还没有医生下发的训练方案</view>
    <view class="card__link">查看方案详情</view>
  </view>

  <view class="card" bindtap="handleOpenProgress">
    <view class="card__title">30天进度</view>
    <view class="card__desc">{{progressSummary}}</view>
    <view class="card__link">查看进度趋势</view>
  </view>

  <view class="card" bindtap="handleOpenAiSummary">
    <view class="card__title">AI 康复小结</view>
    <view class="card__desc">{{aiSummaryPreview}}</view>
    <view class="card__link">查看最新小结</view>
  </view>

  <view class="disclaimer">页面信息仅用于康复训练管理参考，不构成医疗建议。</view>
</view>
