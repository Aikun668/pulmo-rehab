.page {
  padding: 24rpx;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 28rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  margin-bottom: 20rpx;
}

.stats-bar__item {
  flex: 1;
  text-align: center;
}

.stats-bar__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #243447;
  line-height: 1.2;
}

.stats-bar__label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a9aad;
  line-height: 1.3;
}

.stats-bar__divider {
  width: 1rpx;
  height: 60rpx;
  background: #e3ebf5;
}

.card {
  border-radius: 24rpx;
  box-sizing: border-box;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
}

.card + .card {
  margin-top: 20rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
}

.card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.card__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.card__link {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2563eb;
}

.card__status {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card--knowledge {
  background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
  border-color: #bfdbfe;
}
