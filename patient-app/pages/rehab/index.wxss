/* ===== 页面基础 ===== */
.page {
  position: relative;
  min-height: 100vh;
  background: #F5F7FA;
  -webkit-font-smoothing: antialiased;
}

/* ===== 顶部 Banner（400rpx） ===== */
.rehab-banner {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.rehab-banner__img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 渐变遮罩：图片底部边缘自然过渡到页面背景 */
.rehab-banner__gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(245, 247, 250, 0) 0%, #F5F7FA 100%);
  z-index: 1;
}

/* ===== 内容区：叠层效果 ===== */
.rehab-content {
  margin-top: -80rpx;
  padding: 40rpx 24rpx 48rpx;
  position: relative;
  z-index: 2;
}

/* ===== 数据总览卡片 ===== */
.stats-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 0 0 2rpx #BFDBFE, 0 8rpx 32rpx rgba(59, 130, 246, 0.12), 0 4rpx 16rpx rgba(0, 0, 0, 0.10);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stats-card__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== CSS 图标：日历 ===== */
.stats-card__icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.icon-calendar {
  width: 36rpx;
  height: 40rpx;
  position: relative;
}

.icon-calendar__header {
  width: 36rpx;
  height: 10rpx;
  background: #3B82F6;
  border-radius: 4rpx 4rpx 0 0;
  position: absolute;
  top: 0;
}

.icon-calendar__body {
  width: 36rpx;
  height: 30rpx;
  background: #DBEAFE;
  border: 2rpx solid #3B82F6;
  border-radius: 0 0 4rpx 4rpx;
  position: absolute;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-calendar__day {
  font-size: 16rpx;
  font-weight: 700;
  color: #3B82F6;
  line-height: 1;
}

/* ===== CSS 图标：趋势上升 ===== */
.icon-trending {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-trending__line {
  position: absolute;
  bottom: 4rpx;
  left: 2rpx;
  width: 28rpx;
  height: 24rpx;
  border-left: 2rpx solid #3B82F6;
  border-bottom: 2rpx solid #3B82F6;
  border-bottom-left-radius: 4rpx;
  transform: none;
}

.icon-trending__arrow {
  position: absolute;
  bottom: 12rpx;
  right: 0;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-bottom: 8rpx solid #3B82F6;
  transform: rotate(-45deg);
}

/* ===== CSS 图标：时钟 ===== */
.icon-clock {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-clock__face {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #3B82F6;
  background: #DBEAFE;
  position: absolute;
  top: 0;
  left: 0;
}

.icon-clock__hand {
  position: absolute;
  top: 6rpx;
  left: 16rpx;
  width: 3rpx;
  height: 12rpx;
  background: #3B82F6;
  border-radius: 2rpx;
  transform-origin: bottom center;
  transform: rotate(30deg);
}

.icon-clock__dot {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 6rpx;
  height: 6rpx;
  background: #3B82F6;
  border-radius: 50%;
}

.stats-card__value {
  font-size: 52rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
}

.stats-card__label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
}

.stats-card__divider {
  width: 1rpx;
  height: 80rpx;
  background: #F3F4F6;
}

/* ===== 分组标题 ===== */
.section-title {
  display: flex;
  align-items: center;
  margin: 40rpx 0 24rpx 24rpx;
}

.section-title__bar {
  width: 4rpx;
  height: 28rpx;
  background: #3B82F6;
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.section-title__text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

/* ===== 三列小卡片 ===== */
.cards-row {
  display: flex;
  gap: 16rpx;
}

.mini-card {
  width: calc((100vw - 64rpx) / 3);
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.10), 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  transition: all 0.1s;
}

.mini-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.mini-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.mini-card__subtitle {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  line-height: 1.4;
}

.mini-card__illustration {
  height: 140rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-card__link {
  font-size: 24rpx;
  color: #3B82F6;
  margin-top: auto;
  text-align: center;
  padding-top: 8rpx;
}

/* ===== CSS 插图：微立体剪贴板+笔 ===== */
.illust-clipboard {
  position: relative;
  width: 88rpx;
  height: 110rpx;
}

.illust-clipboard__clip {
  position: absolute;
  top: -6rpx;
  left: 24rpx;
  width: 40rpx;
  height: 12rpx;
  background: #93C5FD;
  border-radius: 6rpx 6rpx 0 0;
  box-shadow: 0 2rpx 4rpx rgba(59, 130, 246, 0.2);
}

.illust-clipboard__paper {
  position: absolute;
  top: 6rpx;
  left: 0;
  width: 88rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 8rpx;
  border: 3rpx solid #3B82F6;
  box-shadow: 4rpx 4rpx 0 #BFDBFE, 0 8rpx 24rpx rgba(59, 130, 246, 0.15);
}

.illust-clipboard__lines {
  position: absolute;
  top: 24rpx;
  left: 14rpx;
  width: 60rpx;
  z-index: 1;
}

.illust-clipboard__line {
  height: 4rpx;
  background: #93C5FD;
  border-radius: 2rpx;
  margin-bottom: 10rpx;
  width: 100%;
}

.illust-clipboard__line--short {
  width: 40rpx;
}

.illust-clipboard__pen {
  position: absolute;
  bottom: 8rpx;
  right: -12rpx;
  width: 6rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, #F59E0B, #D97706);
  border-radius: 3rpx;
  transform: rotate(-30deg);
  box-shadow: 0 2rpx 4rpx rgba(217, 119, 6, 0.3);
}

/* ===== CSS 插图：绿色折线图+面积填充 ===== */
.illust-chart {
  position: relative;
  width: 110rpx;
  height: 100rpx;
}

.illust-chart__baseline {
  position: absolute;
  bottom: 12rpx;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: #D1FAE5;
  border-radius: 2rpx;
}

.illust-chart__area {
  position: absolute;
  bottom: 14rpx;
  left: 8rpx;
  right: 8rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.03));
  border-radius: 4rpx 4rpx 0 0;
}

.illust-chart__curve {
  position: absolute;
  bottom: 14rpx;
  left: 8rpx;
  right: 8rpx;
  height: 3rpx;
  background: transparent;
  /* simulate curve with positioned dots */
}

.illust-chart__dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10B981;
  border: 3rpx solid #D1FAE5;
  box-shadow: 0 2rpx 6rpx rgba(16, 185, 129, 0.25);
  z-index: 1;
}

.illust-chart__dot--1 {
  bottom: 16rpx;
  left: 8rpx;
}

.illust-chart__dot--2 {
  bottom: 36rpx;
  left: 36rpx;
}

.illust-chart__dot--3 {
  bottom: 54rpx;
  left: 64rpx;
}

.illust-chart__dot--4 {
  bottom: 72rpx;
  right: 8rpx;
}

/* ===== CSS 插图：微立体AI徽章（紫色系） ===== */
.illust-ai-badge {
  position: relative;
  width: 88rpx;
  height: 110rpx;
}

.illust-ai-badge__shadow {
  position: absolute;
  bottom: -4rpx;
  left: 6rpx;
  width: 80rpx;
  height: 104rpx;
  background: #C4B5FD;
  border-radius: 8rpx;
  opacity: 0.5;
}

.illust-ai-badge__bg {
  position: absolute;
  top: 6rpx;
  left: 0;
  width: 88rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  border-radius: 8rpx;
  border: 3rpx solid #8B5CF6;
  box-shadow: 4rpx 4rpx 0 #C4B5FD, 0 8rpx 24rpx rgba(139, 92, 246, 0.15);
}

.illust-ai-badge__text {
  position: absolute;
  top: 6rpx;
  left: 0;
  width: 88rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #7C3AED;
  letter-spacing: 4rpx;
  z-index: 1;
  font-family: -apple-system, sans-serif;
}

.illust-ai-badge__sparkle {
  position: absolute;
  top: 16rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FBBF24;
  box-shadow: 0 2rpx 6rpx rgba(251, 191, 36, 0.3);
  z-index: 2;
}

/* ===== 知识大卡片 ===== */
.big-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.10), 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  padding: 32rpx;
  display: flex;
  align-items: center;
  transition: all 0.1s;
}

.big-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.big-card__left {
  flex: 55;
  display: flex;
  flex-direction: column;
}

.big-card__right {
  flex: 45;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 16rpx;
}

.big-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.big-card__desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 12rpx;
  line-height: 1.6;
}

.big-card__link {
  font-size: 26rpx;
  color: #10B981;
  margin-top: 20rpx;
  font-weight: 500;
}

/* ===== CSS 插图：3D书籍+播放按钮 ===== */
.illust-book {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.illust-book__shadow {
  position: absolute;
  bottom: 8rpx;
  left: 20rpx;
  width: 100rpx;
  height: 16rpx;
  background: rgba(16, 185, 129, 0.15);
  border-radius: 50%;
  filter: blur(6rpx);
}

.illust-book__back {
  position: absolute;
  top: 20rpx;
  left: 36rpx;
  width: 100rpx;
  height: 120rpx;
  background: #6EE7B7;
  border-radius: 8rpx;
  box-shadow: 4rpx 4rpx 0 #34D399;
}

.illust-book__front {
  position: absolute;
  top: 16rpx;
  left: 28rpx;
  width: 100rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #D1FAE5, #ECFDF5);
  border-radius: 8rpx;
  border: 3rpx solid #10B981;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.2);
}

.illust-book__spine {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  width: 8rpx;
  height: 120rpx;
  background: #10B981;
  border-radius: 4rpx 0 0 4rpx;
}

.illust-book__play {
  position: absolute;
  top: 52rpx;
  left: 64rpx;
  width: 48rpx;
  height: 48rpx;
  background: #10B981;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
  z-index: 1;
}

.illust-book__triangle {
  width: 0;
  height: 0;
  border-left: 16rpx solid #FFFFFF;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  margin-left: 4rpx;
}
