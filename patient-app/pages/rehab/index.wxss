.page {
  padding: 24rpx;
}

.card,
.disclaimer {
  border-radius: 24rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ebf5;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
}

.card + .card {
  margin-top: 20rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
}

.card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.card__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6b7a;
}

.card__link {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2563eb;
}

.card__status {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a9aad;
}

.card__status--error {
  color: #c65b5b;
}

.disclaimer {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  font-size: 22rpx;
  line-height: 1.8;
  color: #c2410c;
}
