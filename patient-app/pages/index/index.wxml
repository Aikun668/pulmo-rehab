<!-- index.wxml -->
<navigation-bar
  title="肺康复训练"
  back="{{false}}"
  color="#1F2937"
  background="#F4F7FB"
></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="hero-card">
      <view class="hero-card__eyebrow">患者首页</view>
      <view class="hero-card__title">{{patientName}}，欢迎回来</view>
      <view class="hero-card__subtitle">{{todayDateLabel}}</view>

      <view class="status-panel">
        <view class="status-panel__item">
          <view class="status-panel__label">今日状态</view>
          <view class="status-panel__value">{{todayStatusLabel}}</view>
        </view>
        <view class="status-panel__item">
          <view class="status-panel__label">建议训练时长</view>
          <view class="status-panel__value">{{dailyTargetMinutes}} 分钟</view>
        </view>
      </view>

      <view class="hero-card__desc">{{todayStatusDescription}}</view>
    </view>

    <view class="section">
      <view class="section__header">
        <view class="section__title">快捷操作</view>
        <view class="section__caption">后续会从这里进入核心功能</view>
      </view>

      <view class="action-list">
        <block wx:for="{{quickActions}}" wx:key="key">
          <view
            class="action-card {{item.tone === 'primary' ? 'action-card--primary' : ''}}"
            bindtap="handleQuickActionTap"
            data-action="{{item.key}}"
          >
            <view class="action-card__title">{{item.title}}</view>
            <view class="action-card__desc">{{item.description}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <view class="section__header">
        <view class="section__title">最近训练方案</view>
        <view class="section__caption">后续将接医生下发方案接口</view>
      </view>

      <view class="info-card">
        <view class="info-card__title">{{latestPlan.title}}</view>
        <view class="info-card__desc">{{latestPlan.description}}</view>
        <view class="info-card__meta">{{latestPlan.updatedAt}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section__header">
        <view class="section__title">AI 康复小结</view>
        <view class="section__caption">当前先保留结构入口</view>
      </view>

      <view class="info-card info-card--soft">
        <view class="info-card__desc">{{aiSummaryHint}}</view>
      </view>
    </view>

    <view class="disclaimer">
      页面信息仅用于康复训练管理参考，不构成医疗建议。
    </view>
  </view>
</scroll-view>
