<navigation-bar title="30天进度" back="{{true}}" color="#1F2937" background="#F5F7FA"></navigation-bar>

<view class="page">
  <view class="summary-card">
    <view class="summary-card__title">训练趋势摘要</view>
    <view class="summary-card__desc">{{progressSummary}}</view>
    <view class="summary-metrics" wx:if="{{!isLoading}}">
      <view class="summary-metric">
        <view class="summary-metric__value">{{trainedDays}}</view>
        <view class="summary-metric__label">训练天数</view>
      </view>
      <view class="summary-metric">
        <view class="summary-metric__value">{{totalDuration}}</view>
        <view class="summary-metric__label">累计分钟</view>
      </view>
      <view class="summary-metric">
        <view class="summary-metric__value">{{totalSets}}</view>
        <view class="summary-metric__label">累计组数</view>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'training' ? 'tab-item--active' : ''}}" data-tab="training" bindtap="handleTabChange">训练时长</view>
    <view class="tab-item {{activeTab === 'vitals' ? 'tab-item--active' : ''}}" data-tab="vitals" bindtap="handleTabChange">生命体征</view>
    <view class="tab-item {{activeTab === 'scores' ? 'tab-item--active' : ''}}" data-tab="scores" bindtap="handleTabChange">自评评分</view>
  </view>

  <!-- 训练时长：折线图 + 豆腐块 -->
  <view class="chart-card" wx:if="{{activeTab === 'training'}}">
    <view class="chart-card__title">近30天训练趋势</view>
    <view class="chart-card__state" wx:if="{{isLoading}}">正在同步近30天训练数据...</view>
    <view class="chart-card__state" wx:elif="{{days.length === 0}}">暂无训练记录</view>
    <block wx:else>
      <!-- 训练时长趋势点状图 -->
      <view class="trend-section">
        <view class="trend-section__header">
          <view class="trend-section__title">训练时长趋势</view>
          <view class="trend-section__unit">分钟</view>
        </view>
        <view class="trend-chart">
          <view class="trend-y-axis">
            <text class="trend-y-label">{{yAxisMax}}</text>
            <text class="trend-y-label">{{yAxisMid}}</text>
            <text class="trend-y-label">0</text>
          </view>
          <view class="trend-points">
            <view class="trend-point-wrap" wx:for="{{trainingPoints}}" wx:key="index">
              <view class="trend-point trend-point--training" style="bottom: {{item.bottomRpx}}rpx;"></view>
              <view class="trend-point__label">{{item.value}}</view>
              <view class="trend-point__date">{{item.date}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 2×2 豆腐块指标卡 -->
      <view class="metric-grid">
        <!-- 日均时长 -->
        <view class="metric-tile metric-tile--blue">
          <view class="metric-tile__data">
            <view class="metric-tile__value">{{avgDuration}}</view>
            <view class="metric-tile__label">日均时长(分钟)</view>
          </view>
          <view class="metric-tile__illustration">
            <view class="illust-clock">
              <view class="illust-clock__shadow"></view>
              <view class="illust-clock__face"></view>
              <view class="illust-clock__hand-long"></view>
              <view class="illust-clock__hand-short"></view>
              <view class="illust-clock__dot"></view>
              <view class="illust-clock__marks">
                <view class="illust-clock__mark"></view>
                <view class="illust-clock__mark"></view>
                <view class="illust-clock__mark"></view>
                <view class="illust-clock__mark"></view>
              </view>
            </view>
          </view>
        </view>

        <!-- 单日最高 -->
        <view class="metric-tile metric-tile--amber">
          <view class="metric-tile__data">
            <view class="metric-tile__value">{{maxDuration}}</view>
            <view class="metric-tile__label">单日最高(分钟)</view>
          </view>
          <view class="metric-tile__illustration">
            <view class="illust-trophy">
              <view class="illust-trophy__shadow"></view>
              <view class="illust-trophy__cup"></view>
              <view class="illust-trophy__neck"></view>
              <view class="illust-trophy__base"></view>
              <view class="illust-trophy__star"></view>
            </view>
          </view>
        </view>

        <!-- 最长连续 -->
        <view class="metric-tile metric-tile--green">
          <view class="metric-tile__data">
            <view class="metric-tile__value">{{maxStreak}}</view>
            <view class="metric-tile__label">最长连续(天)</view>
          </view>
          <view class="metric-tile__illustration">
            <view class="illust-streak">
              <view class="illust-streak__shadow"></view>
              <view class="illust-streak__calendar"></view>
              <view class="illust-streak__header"></view>
              <view class="illust-streak__days">
                <view class="illust-streak__day illust-streak__day--on"></view>
                <view class="illust-streak__day illust-streak__day--on"></view>
                <view class="illust-streak__day illust-streak__day--on"></view>
                <view class="illust-streak__day illust-streak__day--on"></view>
                <view class="illust-streak__day illust-streak__day--on"></view>
                <view class="illust-streak__day illust-streak__day--off"></view>
                <view class="illust-streak__day illust-streak__day--off"></view>
              </view>
              <view class="illust-streak__flame"></view>
            </view>
          </view>
        </view>

        <!-- 疲劳评分 -->
        <view class="metric-tile metric-tile--purple">
          <view class="metric-tile__data">
            <view class="metric-tile__value">{{fatigueScore}}</view>
            <view class="metric-tile__label">疲劳评分(1-10)</view>
          </view>
          <view class="metric-tile__illustration">
            <view class="illust-energy">
              <view class="illust-energy__shadow"></view>
              <view class="illust-energy__body"></view>
              <view class="illust-energy__fill"></view>
              <view class="illust-energy__head"></view>
              <view class="illust-energy__wave"></view>
              <view class="illust-energy__wave illust-energy__wave--2"></view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 生命体征趋势 -->
  <view class="chart-card" wx:if="{{activeTab === 'vitals'}}">
    <view class="chart-card__state" wx:if="{{isLoadingAssessments}}">正在加载评估数据...</view>
    <view class="chart-card__state" wx:elif="{{assessments.heartRate.length === 0 && assessments.spo2.length === 0}}">暂无生命体征记录，完成训练前自评后将在这里展示趋势</view>
    <block wx:else>
      <!-- 心率 -->
      <view class="trend-section" wx:if="{{assessments.heartRate.length > 0}}">
        <view class="trend-section__header">
          <view class="trend-section__title">心率趋势</view>
          <view class="trend-section__unit">bpm</view>
        </view>
        <view class="trend-chart">
          <view class="trend-y-axis">
            <text class="trend-y-label">120</text>
            <text class="trend-y-label">80</text>
            <text class="trend-y-label">40</text>
          </view>
          <view class="trend-points">
            <view class="trend-point-wrap" wx:for="{{assessments.heartRate}}" wx:key="index">
              <view class="trend-point {{item.isWarning ? 'trend-point--warning' : 'trend-point--hr'}}" style="bottom: {{item.bottomRpx}}rpx;"></view>
              <view class="trend-point__label">{{item.value}}</view>
              <view class="trend-point__date">{{item.date}}</view>
            </view>
          </view>
        </view>
        <view class="trend-threshold" wx:if="{{assessments.heartRate.length > 0}}">预警线：120 bpm</view>
      </view>

      <!-- 血氧 -->
      <view class="trend-section" wx:if="{{assessments.spo2.length > 0}}">
        <view class="trend-section__header">
          <view class="trend-section__title">血氧趋势</view>
          <view class="trend-section__unit">%</view>
        </view>
        <view class="trend-chart">
          <view class="trend-y-axis">
            <text class="trend-y-label">100</text>
            <text class="trend-y-label">96</text>
            <text class="trend-y-label">92</text>
          </view>
          <view class="trend-points">
            <view class="trend-point-wrap" wx:for="{{assessments.spo2}}" wx:key="index">
              <view class="trend-point {{item.isWarning ? 'trend-point--warning' : 'trend-point--spo2'}}" style="bottom: {{item.bottomRpx}}rpx;"></view>
              <view class="trend-point__label">{{item.value}}</view>
              <view class="trend-point__date">{{item.date}}</view>
            </view>
          </view>
        </view>
        <view class="trend-threshold" wx:if="{{assessments.spo2.length > 0}}">预警线：92%</view>
      </view>
    </block>
  </view>

  <!-- 自评评分趋势 -->
  <view class="chart-card" wx:if="{{activeTab === 'scores'}}">
    <view class="chart-card__state" wx:if="{{isLoadingAssessments}}">正在加载评估数据...</view>
    <view class="chart-card__state" wx:elif="{{assessments.dyspnea.length === 0 && assessments.fatigue.length === 0}}">暂无自评记录，完成训练前自评后将在这里展示趋势</view>
    <block wx:else>
      <!-- 呼吸困难 -->
      <view class="trend-section" wx:if="{{assessments.dyspnea.length > 0}}">
        <view class="trend-section__header">
          <view class="trend-section__title">呼吸困难评分</view>
          <view class="trend-section__unit">1-5 级</view>
        </view>
        <view class="trend-chart trend-chart--short">
          <view class="trend-y-axis trend-y-axis--short">
            <text class="trend-y-label">5</text>
            <text class="trend-y-label">3</text>
            <text class="trend-y-label">1</text>
          </view>
          <view class="trend-points trend-points--short">
            <view class="trend-point-wrap" wx:for="{{assessments.dyspnea}}" wx:key="index">
              <view class="trend-point {{item.isWarning ? 'trend-point--warning' : 'trend-point--dyspnea'}}" style="bottom: {{item.bottomRpx}}rpx;"></view>
              <view class="trend-point__label">{{item.value}}</view>
              <view class="trend-point__date">{{item.date}}</view>
            </view>
          </view>
        </view>
        <view class="trend-threshold">预警线：4 级</view>
      </view>

      <!-- 疲劳 -->
      <view class="trend-section" wx:if="{{assessments.fatigue.length > 0}}">
        <view class="trend-section__header">
          <view class="trend-section__title">疲劳评分</view>
          <view class="trend-section__unit">1-10 级</view>
        </view>
        <view class="trend-chart trend-chart--short">
          <view class="trend-y-axis trend-y-axis--short">
            <text class="trend-y-label">10</text>
            <text class="trend-y-label">5</text>
            <text class="trend-y-label">1</text>
          </view>
          <view class="trend-points trend-points--short">
            <view class="trend-point-wrap" wx:for="{{assessments.fatigue}}" wx:key="index">
              <view class="trend-point {{item.isWarning ? 'trend-point--warning' : 'trend-point--fatigue'}}" style="bottom: {{item.bottomRpx}}rpx;"></view>
              <view class="trend-point__label">{{item.value}}</view>
              <view class="trend-point__date">{{item.date}}</view>
            </view>
          </view>
        </view>
        <view class="trend-threshold">预警线：8 级</view>
      </view>
    </block>
  </view>
</view>
