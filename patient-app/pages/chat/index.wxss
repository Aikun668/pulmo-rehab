/* ===== 聊天页面 ===== */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F7FB;
  box-sizing: border-box;
}

/* ===== 顶部医师信息 ===== */
.chat-header {
  display: flex;
  align-items: center;
  padding: 44px 16px 14px 16px;
  background: #ffffff;
  border-bottom: 1rpx solid #eef1f6;
}

.chat-header__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-header__info {
  margin-left: 12px;
}

.chat-header__name {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A1A;
}

.chat-header__status {
  font-size: 12px;
  color: #6b7280;
  margin-top: 2px;
}

/* ===== 消息列表 ===== */
.chat-messages {
  flex: 1;
  overflow-y: auto;
}

.chat-messages__inner {
  padding: 16px;
  padding-bottom: 80px;
}

.chat-messages__date-tip {
  text-align: center;
  font-size: 12px;
  color: #9CA3AF;
  margin-bottom: 16px;
}

/* ===== 消息行（仿微信：头像+气泡横向排列） ===== */
.chat-msg {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16px;
}

/* 患者消息：头像在右，row方向 + flex-end推到右端 */
.chat-msg--patient {
  flex-direction: row;
  justify-content: flex-end;
}

/* 医生消息：头像在左 */
.chat-msg--doctor {
  flex-direction: row;
}

/* ===== 头像 ===== */
.chat-msg__avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

/* 医生头像右侧留间距 */
.chat-msg--doctor .chat-msg__avatar {
  margin-right: 10px;
}

/* 患者头像左侧留间距 */
.chat-msg--patient .chat-msg__avatar {
  margin-left: 10px;
}

/* ===== 消息体（气泡+时间纵向排列） ===== */
.chat-msg__body {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 36px - 10px);
}

.chat-msg--patient .chat-msg__body {
  align-items: flex-end;
}

.chat-msg--doctor .chat-msg__body {
  align-items: flex-start;
}

.chat-msg__bubble {
  max-width: 500rpx;
  padding: 10px 14px;
  border-radius: 12px;
  word-break: break-all;
  box-sizing: border-box;
}

.chat-msg__bubble--patient {
  background: #2F5D7C;
  color: #ffffff;
  border-radius: 12px 4px 12px 12px;
}

.chat-msg__bubble--doctor {
  background: #ffffff;
  color: #243447;
  border: 1rpx solid #e5e7eb;
  border-radius: 4px 12px 12px 12px;
}

.chat-msg__text {
  font-size: 14px;
  line-height: 1.5;
}

.chat-msg__time {
  font-size: 10px;
  color: #9CA3AF;
  margin-top: 4px;
}

.chat-msg--patient .chat-msg__time {
  text-align: right;
}

/* ===== 输入区域 ===== */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eef1f6;
  gap: 10px;
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(50px + env(safe-area-inset-bottom));
  z-index: 10;
}

.chat-input-bar__field {
  flex: 1;
  height: 36px;
  background: #F4F7FB;
  border-radius: 18px;
  padding: 0 14px;
  font-size: 14px;
  color: #1A1A1A;
}

.chat-input-bar__send {
  font-size: 14px;
  font-weight: 600;
  color: #9CA3AF;
  padding: 6px 14px;
  border-radius: 18px;
  background: transparent;
  flex-shrink: 0;
}

.chat-input-bar__send--active {
  background: #2A6BFF;
  color: #ffffff;
}
