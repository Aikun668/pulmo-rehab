<view class="chat-page">
  <!-- 顶部：医师信息 -->
  <view class="chat-header">
    <view class="chat-header__avatar" style="background: #2F5D7C;">医</view>
    <view class="chat-header__info">
      <view class="chat-header__name">{{doctorName}}</view>
      <view class="chat-header__status">{{doctorTitle}}</view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <view class="chat-messages__inner">
      <view class="chat-messages__date-tip">{{chatDateTip}}</view>
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-msg {{item.sender === 'patient' ? 'chat-msg--patient' : 'chat-msg--doctor'}}">
        <!-- 医生头像（左侧，和顶部一样的"医"字头像） -->
        <view class="chat-msg__avatar" wx:if="{{item.sender === 'doctor'}}" style="background: #2F5D7C;">医</view>
        <!-- 消息体：气泡+时间 -->
        <view class="chat-msg__body">
          <view class="chat-msg__bubble {{item.sender === 'patient' ? 'chat-msg__bubble--patient' : 'chat-msg__bubble--doctor'}}">
            <text class="chat-msg__text">{{item.text}}</text>
          </view>
          <text class="chat-msg__time">{{item.time}}</text>
        </view>
        <!-- 患者头像（右侧，蓝渐变+姓氏，和"我的"页面头像一致） -->
        <view class="chat-msg__avatar" wx:if="{{item.sender === 'patient'}}" style="background: linear-gradient(135deg, #2a6bff, #5b9bff);">{{patientSurname}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="chat-input-bar">
    <input class="chat-input-bar__field" placeholder="输入消息…" value="{{inputText}}" bindinput="handleInputChange" confirm-type="send" bindconfirm="handleSend" adjust-position="{{true}}" />
    <view class="chat-input-bar__send {{inputText ? 'chat-input-bar__send--active' : ''}}" bindtap="handleSend">发送</view>
  </view>
</view>
